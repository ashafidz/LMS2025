# ============================================================
# .env.docker.example
# Template environment untuk deployment Docker di VPS
# Copy file ini menjadi .env di VPS: cp .env.docker.example .env
# ============================================================

APP_NAME="LMS 2025"
APP_ENV=production
APP_KEY=                              # generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://subdomain.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (sesuaikan dengan docker-compose.yml) ────────
DB_CONNECTION=mysql
DB_HOST=mysql                         # nama service di docker-compose
DB_PORT=3306
DB_DATABASE=lms2025
DB_USERNAME=root
DB_PASSWORD=GANTI_PASSWORD_YANG_KUAT

# ── Session ───────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Driver: Redis untuk Cache & Queue ─────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis                      # nama service di docker-compose
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lms2025.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Midtrans ─────────────────────────────────────────────
MIDTRANS_MERCHANT_ID=GANTI_DENGAN_MERCHANT_ID_ANDA
MIDTRANS_CLIENT_KEY=GANTI_DENGAN_CLIENT_KEY_ANDA
MIDTRANS_SERVER_KEY=GANTI_DENGAN_SERVER_KEY_ANDA
